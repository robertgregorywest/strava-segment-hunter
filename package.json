{
  "name": "strava-segment-hunter",
  "version": "1.0.0",
  "description": "Personal tool for hunting attainable Strava KOMs, ranked by wind impact.",
  "private": true,
  "type": "module",
  "scripts": {
    "auth": "tsx src/strava/authorize.ts",
    "sync": "tsx --env-file-if-exists=.env src/sync/index.ts",
    "sync:backfill": "tsx --env-file-if-exists=.env src/sync/index.ts --backfill",
    "sync:schedule": "./scripts/schedule-sync.sh",
    "api": "tsx --env-file-if-exists=.env src/api/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "dotenv": "^17.4.2"
  },
  "allowScripts": {
    "better-sqlite3@13.0.3": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true
  }
}
