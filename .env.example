STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REDIRECT_URI=http://localhost:8721/callback
STRAVA_TOKEN_PATH=data/strava-tokens.json

# Home location, used as the default search origin and to prioritise enrichment.
HOME_LAT=
HOME_LNG=

# Rider parameters feeding the wind-impact physical model.
RIDER_MASS_KG=78
RIDER_CDA=0.32
RIDER_CRR=0.005
WIND_ROUGHNESS_FACTOR=0.55

DB_PATH=data/segment-hunter.db
API_PORT=3000

KOM_FRESHNESS_DAYS=14
WIND_NEUTRAL_THRESHOLD=0.5
FORECAST_CACHE_MINUTES=60
